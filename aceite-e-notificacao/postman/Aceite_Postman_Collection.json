						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "http://{{host}}/health",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"health"
							]
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Acceptances",
			"item": [
				{
					"name": "Cria um aceite",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"execution_id\": \"exec-abc-123\",\n  \"channel_type\": \"whatsapp\",\n  \"destination\": \"+5511999990000\",\n  \"template_id\": \"{{template_id}}\",\n  \"channel_params\": {\n    \"steps\": [\n      {\n        \"step_id\": \"decisao\",\n        \"sequence\": 1,\n        \"type\": \"template\",\n        \"content\": {\n          \"template\": {\n            \"variables\": { \"body\": [\"João Silva\", \"CTR-2024-001\"] }\n          }\n        }\n      }\n    ]\n  },\n  \"metadata\": {\n    \"organization\": \"Acme Ltda\"\n  },\n  \"webhook_url\": \"https://meu-sistema.com/callbacks/acceptance\",\n  \"expiration_time\": 86400\n}"
						},
						"url": {
							"raw": "http://{{host}}/api/v1/acceptances",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"api",
								"v1",
								"acceptances"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('acceptance_id', body.acceptance_id);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Recebe evento de status (simulação)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"SENT\"\n}"
						},
						"url": {
							"raw": "http://{{host}}/api/v1/acceptances/{{acceptance_id}}/status",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"api",
								"v1",
								"acceptances",
								"{{acceptance_id}}",
								"status"
							]
						}
					},
					"response": []
				},
				{
					"name": "Recebe interação de botão (simulação)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"step_id\": \"decisao\",\n  \"button_text\": \"Aceitar\"\n}"
						},
						"url": {
							"raw": "http://{{host}}/api/v1/acceptances/{{acceptance_id}}/step",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"api",
								"v1",
								"acceptances",
								"{{acceptance_id}}",
								"step"
							]
						}
					},
					"response": []
				}
			]
		},
