meta {
  name: Texto longo
  type: http
  seq: 18
}

post {
  url: https://{{host}}/api/v1/forms/{{form_key}}/versions
  body: json
  auth: inherit
}

body:json {
{
  "settings": {
    "title": "Atualização de contato",
    "subtitle": "Por favor, confirme os dados de contato.",
    "finish_title": "Atualização de dados concluída!",
    "finish_subtitle": "Em breve nossa equipe entrará em contato.",
    "finish_info": "Visite nosso site para mais informações."
  },
  "fields": [
    {
      "label": "Notes",
      "type": "textarea",
      "placeholder": "Additional comments or context",
      "help_balloon": "Use este campo para textos longos.",
      "required": false,
      "order": 1,
      "step": 0,
      "options": {
        "maxlength": 2000
      }
    }
  ]
}
}
