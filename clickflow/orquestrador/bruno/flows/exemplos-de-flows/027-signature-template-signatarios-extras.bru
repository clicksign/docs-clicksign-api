meta {
  name: Signature — template + signatários extras
  type: http
  seq: 27
}

post {
  url: https://{{host}}/api/v1/flows
  body: json
  auth: inherit
}

body:json {
{
  "name": "Proposta Crédito — assinatura com signatários extras",
  "steps": [
    {
      "context": {
        "documents": [
          {
            "filename": "{{person_name}}.docx",
            "kind": "template",
            "template_key": "uuid-do-modelo-tavola"
          }
        ],
        "settings": {
          "folder_key": "1fb29ab8-84c4-4856-be37-5fce0f17c11a",
          "name": "Envelope {{person_name}}"
        },
        "signers": [
          {
            "auths": [
              "handwritten"
            ],
            "birthday": "2021-07-15",
            "communicate_events": {
              "document_signed": "email",
              "signature_reminder": "email",
              "signature_request": "email"
            },
            "documentation": "34623794024",
            "email": "signatario.fixo@mail.com",
            "group": 1,
            "has_documentation": true,
            "location_required_enabled": true,
            "name": "Signatário Fixo",
            "phone_number": "49999999999",
            "refusable": false,
            "roles": [
              "witness"
            ]
          },
          {
            "auths": [
              "liveness",
              "whatsapp"
            ],
            "birthday": "{{person_birthday}}",
            "documentation": "{{person_documentation}}",
            "group": 2,
            "name": "{{person_name}}",
            "phone_number": "{{phone_number}}",
            "roles": [
              "sign"
            ]
          }
        ]
      },
      "type": "signature"
    }
  ]
}
}
